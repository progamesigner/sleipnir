#!/command/with-contenv sh

[ "${SLEIPNIR_ENABLE_TAILSCALE:-0}" = "1" ] || exit 0

[ "$(s6-svstat -o wantedup .)" = "true" ] || exit 0

echo "sleipnir: tailscaled exited (status=$1 signal=$2); stopping container" >&2
echo 1 > /run/s6-linux-init-container-results/exitcode
exec /run/s6/basedir/bin/halt
