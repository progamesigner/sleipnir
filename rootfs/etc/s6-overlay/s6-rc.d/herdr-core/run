#!/command/with-contenv sh
if [ "${SLEIPNIR_ENABLE_HERMOD:-0}" = "1" ]; then
    s6-setuidgid ubuntu /usr/local/bin/sleipnir-hermod install || \
        echo "sleipnir: Hermod hook installation failed" >&2
fi
[ "${SLEIPNIR_ENABLE_HERDR_CORE:-1}" = "1" ] || { s6-svc -O . ; exit 0 ; }
exec s6-notifyoncheck -d -n 0 -w 1000 -c "s6-setuidgid ubuntu /etc/s6-overlay/s6-rc.d/herdr-core/data/check" \
    s6-setuidgid ubuntu python3 /etc/s6-overlay/s6-rc.d/herdr-core/data/monitor
