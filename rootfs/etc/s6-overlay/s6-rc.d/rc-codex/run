#!/command/with-contenv sh

[ "${SLEIPNIR_ENABLE_RC_CODEX:-0}" = "1" ] || { s6-svc -O . ; exit 0 ; }

if [ -n "${SLEIPNIR_RC_CODEX_HOME:-}" ]; then
    export CODEX_HOME="${SLEIPNIR_RC_CODEX_HOME}"
fi

cd /workspace || exit 1

s6-setuidgid ubuntu codex remote-control start || exit 1

while s6-setuidgid ubuntu codex app-server daemon version > /dev/null 2>&1 ; do
    sleep 30
done

echo "sleipnir: codex app-server is gone, restarting remote control" >&2
exit 1
