#!/command/with-contenv sh

[ "${SLEIPNIR_ENABLE_OSEWA:-1}" = "1" ] || { s6-svc -O . ; exit 0 ; }

cd /home/ubuntu || exit 1

set -- server --listen "${OSEWA_LISTEN:-:7322}" --name "${OSEWA_NAME:-${TS_HOSTNAME:-sleipnir}}"
[ "${OSEWA_QUIC:-1}" = "1" ] || set -- "$@" --no-quic

exec s6-setuidgid ubuntu osewa "$@"
