#!/command/with-contenv sh

[ "${SLEIPNIR_ENABLE_TAILSCALE:-1}" = "1" ] || exit 0

if [ -z "${TS_AUTHKEY}" ] ; then
    echo "sleipnir: TS_AUTHKEY is empty, skipping 'tailscale up'" >&2
    exit 0
fi

i=0
while [ ! -S /run/tailscale/tailscaled.sock ] && [ "${i}" -lt 60 ] ; do
    sleep 0.5
    i=$((i + 1))
done

exec s6-setuidgid ubuntu tailscale --socket=/run/tailscale/tailscaled.sock up \
    --accept-dns=false \
    --accept-routes=false \
    --authkey="${TS_AUTHKEY}" \
    --hostname="${TS_HOSTNAME:-sleipnir}" \
    --ssh
