#!/command/with-contenv sh

for DIRECTORY in \
    /home/ubuntu/.agents \
    /home/ubuntu/.cache \
    /home/ubuntu/.cache/copilot \
    /home/ubuntu/.cache/uv \
    /home/ubuntu/.claude \
    /home/ubuntu/.codex \
    /home/ubuntu/.config \
    /home/ubuntu/.config/gh \
    /home/ubuntu/.config/herdr \
    /home/ubuntu/.config/herdr-core \
    /home/ubuntu/.config/moshi \
    /home/ubuntu/.config/opencode \
    /home/ubuntu/.copilot \
    /home/ubuntu/.gemini \
    /home/ubuntu/.local \
    /home/ubuntu/.local/bin \
    /home/ubuntu/.local/share \
    /home/ubuntu/.local/share/claude \
    /home/ubuntu/.local/share/opencode \
    /home/ubuntu/.local/share/uv \
    /home/ubuntu/.local/state \
    /home/ubuntu/.local/state/gh \
    /home/ubuntu/.local/state/herdr \
    /home/ubuntu/.local/state/moshi \
    /home/ubuntu/.local/state/opencode \
    /home/ubuntu/.vscode-cli \
    /home/ubuntu/.vscode-server \
    /run/tailscale \
    /usr/local/npm \
    /usr/local/npm/bin \
    /usr/local/npm/lib \
    /usr/local/uv \
    /usr/local/uv/bin \
    /usr/local/uv/tools \
    /var/lib/tailscale \
    "${SLEIPNIR_WORKSPACE:-/home/ubuntu/workspaces}"
do
    if [ -d ${DIRECTORY} ]; then
        chown ubuntu:ubuntu ${DIRECTORY}
    else
        install -d -o ubuntu -g ubuntu -m 0755 ${DIRECTORY}
    fi
done

for DIRECTORY in \
    /home/ubuntu/.config/osewa \
    /home/ubuntu/.gnupg \
    /home/ubuntu/.local/state/herdr-core \
    /home/ubuntu/.local/state/sleipnir \
    /home/ubuntu/.local/state/osewa \
    /home/ubuntu/.ssh
do
    install -d -o ubuntu -g ubuntu -m 0700 ${DIRECTORY}
done

[ -e /home/ubuntu/.claude/.claude.json ] || install -o ubuntu -g ubuntu -m 0644 /dev/null /home/ubuntu/.claude/.claude.json
ln -sf /home/ubuntu/.claude/.claude.json /home/ubuntu/.claude.json
chown -h ubuntu:ubuntu /home/ubuntu/.claude.json

# herdr-core forgets its terminals when the machine ID changes, and each image build makes a new one.
machine_id=/home/ubuntu/.local/state/sleipnir/machine-id
if ! grep -Eqx '[0-9a-f]{32}' "${machine_id}" 2>/dev/null; then
    tr -d '-' < /proc/sys/kernel/random/uuid > "${machine_id}"
    chown ubuntu:ubuntu "${machine_id}"
fi
cat "${machine_id}" > /etc/machine-id
[ -d /var/lib/dbus ] && cat "${machine_id}" > /var/lib/dbus/machine-id
