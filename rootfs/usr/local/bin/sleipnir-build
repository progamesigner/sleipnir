#!/usr/bin/env bash

set -euo pipefail

usage() {
    cat <<'EOF'
Usage: sleipnir-build [options] [context] [-- buildctl-options]

Build a Dockerfile with the BuildKit service configured by BUILDKIT_HOST.
The result stays in BuildKit's cache unless an output is selected.

Options:
  -f, --file FILE       Dockerfile path (default: CONTEXT/Dockerfile)
  -o, --oci FILE        export an OCI image archive
      --push IMAGE      push the image to a registry
      --platform VALUE  target platform, such as linux/amd64
      --target VALUE    target build stage
      --no-cache        disable the build cache
  -h, --help            show this help

Examples:
  sleipnir-build .
  sleipnir-build --oci /tmp/image.tar .
  sleipnir-build --push ghcr.io/example/app:test .
  sleipnir-build -- --opt build-arg:VERSION=1.2.3
EOF
}

context=.
context_set=0
dockerfile=
output=type=cacheonly
platform=
target=
no_cache=0
declare -a extra=()

while (( $# > 0 )); do
    case "$1" in
        -f|--file)
            dockerfile=${2:?missing value for $1}
            shift 2
            ;;
        -o|--oci)
            output="type=oci,dest=${2:?missing value for $1}"
            shift 2
            ;;
        --push)
            output="type=image,name=${2:?missing value for $1},push=true"
            shift 2
            ;;
        --platform)
            platform=${2:?missing value for $1}
            shift 2
            ;;
        --target)
            target=${2:?missing value for $1}
            shift 2
            ;;
        --no-cache)
            no_cache=1
            shift
            ;;
        -h|--help)
            usage
            exit 0
            ;;
        --)
            shift
            extra+=("$@")
            break
            ;;
        -*)
            echo "unknown option: $1" >&2
            usage >&2
            exit 2
            ;;
        *)
            if (( context_set )); then
                echo "only one build context may be specified" >&2
                exit 2
            fi
            context=$1
            context_set=1
            shift
            ;;
    esac
done

if [[ -z $dockerfile ]]; then
    dockerfile=${context%/}/Dockerfile
fi

if [[ ! -d $context ]]; then
    echo "build context is not a directory: $context" >&2
    exit 2
fi

if [[ ! -f $dockerfile ]]; then
    echo "Dockerfile does not exist: $dockerfile" >&2
    exit 2
fi

dockerfile_dir=$(dirname "$dockerfile")
dockerfile_name=$(basename "$dockerfile")
declare -a command=(
    buildctl
    --addr "${BUILDKIT_HOST:-unix:///run/buildkit/buildkitd.sock}"
    build
    --frontend dockerfile.v0
    --local "context=$context"
    --local "dockerfile=$dockerfile_dir"
    --opt "filename=$dockerfile_name"
    --output "$output"
)

if [[ -n $platform ]]; then
    command+=(--opt "platform=$platform")
fi

if [[ -n $target ]]; then
    command+=(--opt "target=$target")
fi

if (( no_cache )); then
    command+=(--no-cache)
fi

command+=("${extra[@]}")
exec "${command[@]}"
